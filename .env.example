# ======================================
# ENVIRONMENT CONFIGURATION
# Copy this file to .env and set your values
# ======================================

# Server Configuration
PORT=3000

# NO API KEY REQUIRED!
# Using mempool.space public API (free, no registration)

# Faucet Configuration
# Random amount range (in satoshis)
# Users will receive a random amount between MIN and MAX
FAUCET_AMOUNT_MIN=5000
FAUCET_AMOUNT_MAX=15000

# Or use fixed amount (comment out MIN/MAX above and use this):
# FAUCET_AMOUNT=10000

# Network Fee Configuration
NETWORK_FEE=300
FEE_TYPE=fixed  # fixed or dynamic

# Custom Send Limits
ENFORCE_MIN_MAX=false  # Set to 'true' to enforce limits, 'false' for unlimited amounts
CUSTOM_SEND_ENABLED=true
CUSTOM_SEND_MIN=1000
CUSTOM_SEND_MAX=1000000

# Faucet Wallet Configuration
# IMPORTANT: Generate a NEW testnet wallet for the faucet
# You can generate one at: https://privatekeys.pw/keys/bitcoin/testnet
# DO NOT use a wallet that contains real Bitcoin!

# Your faucet's Bitcoin testnet private key (WIF format)
FAUCET_PRIVATE_KEY=cQjsQnrpS5U9CTMZN6iZLVyn557xWK5K97QigUq6sQLQqbkhr3mv

# Your faucet's Bitcoin testnet address
FAUCET_ADDRESS=mvedqC8G7JvjXu1SM3AxLCJsYkzDtQnL5L

# Admin Panel Credentials
# IMPORTANT: Keep these secure!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BitcoinFaucet2025!Secure
